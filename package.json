{
  "name": "bsign-web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test:docker": "node tests/docker-smoke.js",
    "test:dev": "node tests/dev-smoke.js",
    "test:preview": "node tests/preview-browser.js",
    "test:admin": "node tests/admin-browser.js"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.0",
    "supertest": "^7.3.2",
    "vite": "^8.3.8"
  }
}
